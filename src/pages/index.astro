---
import SiteLayout from '../layouts/SiteLayout.astro';
import { programs } from '../lib/programs';
---
<SiteLayout title="Scholars Are Ballers" description="Football development and academic preparation at Eruditeballersafrica Football Academy.">
  <section class="hero">
    <img class="hero-photo" src="/images/hero-coach.png" alt="Erudite coach leading a football training session" width="1254" height="1254" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="container hero-content"><p class="hero-kicker">Eruditeballersafrica Football Academy</p><h1>Scholars<br />are <em>ballers.</em></h1><p class="hero-copy">A place to sharpen your game, keep learning, and build a future with purpose.</p><div class="hero-actions"><a class="btn" href="/apply">Start an application <span aria-hidden="true">↗</span></a><a class="hero-link" href="/about">Meet the academy <span aria-hidden="true">↓</span></a></div></div>
    <div class="hero-caption"><span>Football first. Future always.</span><span>Player development · Academic preparation</span></div>
    <div class="hero-index" aria-hidden="true">EA<span>—</span>01</div>
  </section>
  <section class="intro section"><div class="container intro-grid"><div><p class="eyebrow">The Erudite way</p><h2>Talent opens<br />the door.<br /><span>Discipline takes you further.</span></h2></div><div class="intro-copy"><div class="accent-rule"></div><p>Eruditeballersafrica brings football development and academic direction together. We help young people build their ability on the pitch while growing the confidence, focus, and habits that carry into everyday life.</p><a class="link-arrow" href="/about">Our approach <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="program-section section-dark section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Find your pathway</p><h2>Room to grow.<br /><span>Work to do.</span></h2></div><p>Every player starts somewhere. Explore the pathways that make up the Erudite experience.</p></div><div class="program-grid">{programs.map((program, index) => <a class="program-card" href={program.href}><div class="program-number">0{index + 1}</div><div><p class="program-label">{program.label}</p><h3>{program.title}</h3><p>{program.text}</p><span class="program-arrow" aria-hidden="true">↗</span></div></a>)}</div></div></section>
  <section class="pathway section"><div class="container pathway-grid"><div class="pathway-image"><img src="/images/team-community.jpg" alt="Academy players and community members together" width="3552" height="2841" loading="lazy" /><span class="image-stamp">One team<br />Many futures</span></div><div><p class="eyebrow">The full player</p><h2>Build your game.<br />Back your future.</h2><p>Training is only part of the journey. Our approach connects football, education, and personal development so players can make confident choices at every stage.</p><div class="path-points"><div><span>01</span><p><strong>Train with intent</strong><br />Develop technical skill, game understanding, and teamwork.</p></div><div><span>02</span><p><strong>Stay curious</strong><br />Keep learning in the classroom and beyond.</p></div><div><span>03</span><p><strong>Move forward</strong><br />Build the character and guidance to take your next step.</p></div></div><a class="link-arrow" href="/academics">Explore academics & prep <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="egg-section"><div class="container egg-grid"><div><p class="eyebrow">Stories from the touchline</p><h2>The EGG<br />Show</h2><p>Conversations about football, growth, and the people helping young players find their way.</p><a class="btn btn-outline" href="/egg-show">Discover the EGG Show <span aria-hidden="true">↗</span></a></div><div class="egg-art" aria-label="The EGG Show, academy conversations"><span class="egg-ring">E</span><span class="egg-label">Erudite Growth & Goals</span><span class="egg-play" aria-hidden="true">▶</span></div></div></section>
  <section class="closing-cta"><div class="container cta-inner"><p class="eyebrow">Your next step starts here</p><h2>Ready to put in<br />the work?</h2><p>Parents and guardians can tell us a little about a player and the pathway they’re interested in.</p><a class="btn" href="/apply">Make an enquiry <span aria-hidden="true">↗</span></a></div></section>
  <style>
    .hero{min-height:min(760px,calc(100svh - 7rem));position:relative;display:flex;align-items:center;background:var(--navy);color:white;overflow:hidden}.hero-photo,.hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-photo{object-position:62% 43%}.hero-shade{background:linear-gradient(90deg,rgba(8,24,52,.94) 0%,rgba(8,24,52,.76) 40%,rgba(8,24,52,.12) 85%),linear-gradient(0deg,rgba(8,24,52,.48),transparent 32%)}.hero-content{position:relative;z-index:1;padding:5rem 0}.hero-kicker,.hero-caption,.hero-index{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.17em}.hero-kicker{color:var(--gold)}.hero h1 em{color:var(--gold);font-style:normal}.hero-copy{max-width:28rem;color:#e0e6ee;font-size:1.08rem}.hero-actions{display:flex;align-items:center;gap:1.5rem;margin-top:2rem}.hero-link{font-size:.78rem;text-decoration:none;text-transform:uppercase;letter-spacing:.07em}.hero-link:hover{color:var(--gold)}.hero-caption{position:absolute;z-index:1;left:max(calc((100% - 1180px)/2),1.5rem);right:max(calc((100% - 1180px)/2),1.5rem);bottom:1.5rem;display:flex;justify-content:space-between;color:#fff9}.hero-index{position:absolute;right:2rem;top:50%;writing-mode:vertical-rl;color:#fff9}.hero-index span{color:var(--gold);margin:.8rem 0}.intro-grid,.pathway-grid,.egg-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:5rem;align-items:center}.intro h2 span{color:var(--blue)}.intro-copy{max-width:32rem}.intro-copy p,.pathway-grid>div>p:not(.eyebrow){font-size:1.06rem}.program-section{background:var(--navy)}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:3rem;margin-bottom:2.5rem}.section-heading h2 span{color:var(--gold)}.section-heading>p{max-width:25rem}.program-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ffffff40}.program-card{min-height:260px;color:#fff;text-decoration:none;padding:1.4rem 1.4rem 1.4rem 0;display:flex;gap:1.2rem;position:relative;border-bottom:1px solid #ffffff40}.program-card:not(:last-child){border-right:1px solid #ffffff40;margin-right:1.4rem}.program-card:hover h3{color:var(--gold)}.program-number{font:600 1.2rem var(--display);color:var(--gold)}.program-label{color:#aebbd0;font-size:.68rem;text-transform:uppercase;letter-spacing:.11em;margin-bottom:1.6rem}.program-card h3{font-size:2rem}.program-card p:not(.program-label){font-size:.87rem;max-width:19rem}.program-arrow{position:absolute;right:1.5rem;bottom:1.5rem;color:var(--gold);font-size:1.4rem}.pathway-grid{grid-template-columns:1fr 1fr}.pathway-image{height:550px;position:relative}.pathway-image img{height:100%;width:100%;object-fit:cover;object-position:center}.image-stamp{position:absolute;right:-1.2rem;bottom:2rem;background:var(--gold);color:var(--navy);padding:1rem 1.3rem;font:700 1.25rem/.95 var(--display);text-transform:uppercase}.path-points{margin:2rem 0}.path-points>div{display:flex;gap:1.1rem;border-top:1px solid var(--line);padding:.9rem 0}.path-points>div>span{font:600 1.2rem var(--display);color:var(--blue)}.path-points p{margin:0;font-size:.88rem}.path-points strong{color:var(--ink)}.egg-section{background:#e8edf2;padding:5rem 0}.egg-grid{grid-template-columns:.8fr 1.2fr}.egg-grid h2{font-size:clamp(4rem,8vw,7rem);color:var(--navy)}.egg-art{height:340px;background:var(--blue);color:white;position:relative;display:grid;place-items:center;overflow:hidden}.egg-ring{position:absolute;font:800 32rem/.7 var(--display);color:#ffffff13;transform:rotate(-13deg)}.egg-label{position:absolute;left:1.5rem;top:1.5rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.18em}.egg-play{width:4rem;height:4rem;display:grid;place-items:center;border:1px solid #fff;border-radius:50%;font-size:.9rem;padding-left:.2rem}.closing-cta{background:var(--gold);color:var(--navy);text-align:center;padding:5.5rem 0}.cta-inner{display:grid;justify-items:center}.cta-inner .eyebrow{color:#4e411d}.cta-inner h2{font-size:clamp(3rem,7vw,5.8rem)}.cta-inner>p:not(.eyebrow){max-width:36rem;color:#45401f}@media(max-width:780px){.hero{min-height:650px}.hero-photo{object-position:64% center}.hero-shade{background:linear-gradient(90deg,rgba(8,24,52,.9),rgba(8,24,52,.3)),linear-gradient(0deg,rgba(8,24,52,.45),transparent 40%)}.intro-grid,.pathway-grid,.egg-grid{grid-template-columns:1fr;gap:2.5rem}.section-heading{display:block}.section-heading>p{margin-top:1rem}.program-grid{grid-template-columns:1fr}.program-card{min-height:200px}.program-card:not(:last-child){border-right:0;margin-right:0}.pathway-image{height:420px;margin-right:1rem}.egg-art{height:270px}}@media(max-width:520px){.hero{min-height:590px}.hero-caption{left:1rem;right:1rem;bottom:1rem;font-size:.57rem}.hero-caption span:last-child{max-width:45%;text-align:right}.hero-index{right:1rem}.hero-actions{align-items:flex-start;flex-direction:column;gap:1rem}.pathway-image{height:350px}}
  </style>
</SiteLayout>
