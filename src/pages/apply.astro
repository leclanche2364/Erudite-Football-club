---
export const prerender = false;
import SiteLayout from '../layouts/SiteLayout.astro';
import { actions, isInputError } from 'astro:actions';
const result = Astro.getActionResult(actions.submitApplication);
const errors = result?.error && isInputError(result.error) ? result.error.fields : undefined;
const submitted = result?.data?.success === true;
---
<SiteLayout title="Make an Application">
  <section class="apply-head"><div class="container"><p class="eyebrow">Start a conversation</p><h1>Tell us about<br/>your player.</h1><p>A parent or guardian can share a few details. The academy team can then follow up about the pathway and current next steps.</p></div></section>
  <section class="section apply-section"><div class="container apply-grid"><aside><p class="eyebrow">Before you begin</p><h2>A few details<br/>to get started.</h2><p>We ask for a guardian’s contact information so the academy can respond to an enquiry about a young player.</p><div class="notice"><p><strong>Privacy matters.</strong> We only ask for the information needed to follow up. Please don’t include medical details in this form.</p></div><p class="small-note">Applications are enquiries and do not guarantee acceptance or placement.</p></aside>
    {submitted ? <div class="application-form success-card" role="status"><p class="eyebrow">Enquiry sent</p><h2>Thank you for getting in touch.</h2><p>The academy has received your enquiry. A parent or guardian can expect follow-up using the contact details provided.</p><a class="btn" href="/">Back to the academy</a></div> : <form class="application-form" method="POST" action={actions.submitApplication}>
      {result?.error && <div class="form-error" role="alert">Some details need attention. Review the fields marked below and try again.</div>}
      <div class="form-field"><label for="player_name">Player’s full name <span aria-hidden="true">*</span></label><input id="player_name" name="player_name" autocomplete="name" required minlength="2" maxlength="100" aria-invalid={errors?.player_name ? 'true' : undefined} />{errors?.player_name && <small class="field-error">{errors.player_name[0]}</small>}</div>
      <div class="form-field"><label for="pathway">Pathway of interest <span aria-hidden="true">*</span></label><select id="pathway" name="pathway" required aria-invalid={errors?.pathway ? 'true' : undefined}><option value="">Choose a pathway</option><option value="residency">Erudite Residency</option><option value="u10">Youth category U10</option><option value="u12">Youth category U12</option><option value="u14">Youth category U14</option><option value="u16">Youth category U16</option></select><small>Contact us to confirm current age eligibility.</small>{errors?.pathway && <small class="field-error">{errors.pathway[0]}</small>}</div>
      <div class="form-field"><label for="academic_level">Current academic level / schooling status <span aria-hidden="true">*</span></label><input id="academic_level" name="academic_level" autocomplete="off" required maxlength="120" placeholder="e.g. primary school, secondary school…" aria-invalid={errors?.academic_level ? 'true' : undefined} />{errors?.academic_level && <small class="field-error">{errors.academic_level[0]}</small>}</div>
      <div class="form-field"><label for="primary_position">Primary playing position <span aria-hidden="true">*</span></label><select id="primary_position" name="primary_position" required aria-invalid={errors?.primary_position ? 'true' : undefined}><option value="">Choose a position</option><option>Goalkeeper</option><option>Defender</option><option>Midfielder</option><option>Forward</option><option>Still exploring</option></select>{errors?.primary_position && <small class="field-error">{errors.primary_position[0]}</small>}</div>
      <div class="form-field"><label for="guardian_name">Parent or guardian’s name <span aria-hidden="true">*</span></label><input id="guardian_name" name="guardian_name" autocomplete="name" required minlength="2" maxlength="100" aria-invalid={errors?.guardian_name ? 'true' : undefined} />{errors?.guardian_name && <small class="field-error">{errors.guardian_name[0]}</small>}</div>
      <div class="form-field"><label for="guardian_phone">Parent or guardian’s phone / WhatsApp <span aria-hidden="true">*</span></label><input id="guardian_phone" name="guardian_phone" type="tel" autocomplete="tel" inputmode="tel" required minlength="7" maxlength="30" placeholder="e.g. +233…" aria-invalid={errors?.guardian_phone ? 'true' : undefined} />{errors?.guardian_phone && <small class="field-error">{errors.guardian_phone[0]}</small>}</div>
      <div class="form-field"><label for="message">Anything you’d like us to know? <span class="optional">Optional</span></label><textarea id="message" name="message" rows="4" maxlength="1000" placeholder="Share a question or relevant context…"></textarea></div>
      <label class="check-row"><input type="checkbox" name="conduct_acknowledged" value="true" required /><span>I confirm the academy’s Code of Conduct has been shared with me, and I have read and agree to it. <span aria-hidden="true">*</span></span></label>
      <label class="check-row"><input type="checkbox" name="medical_policy_acknowledged" value="true" required /><span>I confirm the academy’s medical policy has been shared with me, and I acknowledge it. <span aria-hidden="true">*</span></span></label>
      <input class="honey" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn submit-btn" type="submit">Send application enquiry <span aria-hidden="true">↗</span></button>
      <p class="privacy-note">By sending this form, you confirm that you are the player’s parent or legal guardian, or are submitting with their permission. We will use these details to respond to your enquiry. <a href="/privacy">Read the privacy notice</a>.</p>
    </form>}
  </div></section>
  <style>.apply-head{background:var(--navy);color:#fff;padding:5rem 0 4.5rem}.apply-head .eyebrow{color:var(--gold)}.apply-head h1{font-size:clamp(3.7rem,9vw,7rem)}.apply-head p:last-child{max-width:36rem;color:#d6dfeb;font-size:1.05rem}.apply-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem;align-items:start}.apply-grid aside{position:sticky;top:8rem}.apply-grid aside>p:not(.eyebrow){max-width:25rem}.apply-grid h2{font-size:clamp(2.5rem,5vw,4rem)}.small-note{margin-top:1.5rem;font-size:.8rem}.application-form{background:#fff;padding:2rem;border-top:4px solid var(--gold)}.success-card h2{font-size:clamp(2.5rem,5vw,4rem)}.form-field small{color:var(--muted);font-size:.75rem}.form-field .field-error,.form-error{color:#a51f1f}.form-error{background:#fff1f0;padding:1rem;margin-bottom:1rem;border-left:4px solid #b3261e}.optional{font-size:.75rem;color:var(--muted);font-weight:400;margin-left:.3rem}.privacy-note{font-size:.75rem}.submit-btn{cursor:pointer}.honey{position:absolute;left:-10000px;width:1px;height:1px}@media(max-width:760px){.apply-grid{grid-template-columns:1fr;gap:2rem}.apply-grid aside{position:static}.application-form{padding:1.25rem}}
  </style>
</SiteLayout>
