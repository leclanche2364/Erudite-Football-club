---
import SiteLayout from '../layouts/SiteLayout.astro';
const groups = [{age:'U10',focus:'Curiosity & confidence',desc:'Build a positive relationship with the game through movement, ball familiarity, and learning with others.'},{age:'U12',focus:'Technique & teamwork',desc:'Strengthen core skills, awareness, and communication in a supportive team environment.'},{age:'U14',focus:'Understanding & intent',desc:'Develop decision-making, match understanding, and the discipline to keep improving.'},{age:'U16',focus:'Preparation & progression',desc:'Help players take greater ownership of development and explore appropriate next steps.'}];
---
<SiteLayout title="Youth Development">
  <section class="page-hero"><img src="/images/youth-training.jpg" alt="Young player taking part in football training" width="3669" height="2752" fetchpriority="high"/><div class="page-overlay"></div><div class="container page-title"><p class="eyebrow">Youth development</p><h1>Every stage<br/>has a next step.</h1><p>Age-group pathways that help young players build skills, confidence, and a lasting love for the game.</p><a class="btn" href="/apply">Enquire about youth football ↗</a></div></section>
  <section class="section"><div class="container"><div class="intro-head"><p class="eyebrow">Our age groups</p><h2>Learn the game.<br/>Grow into it.</h2><p>The labels below describe our pathway structure. Please contact the academy to confirm current training groups and age eligibility.</p></div><div class="age-grid">{groups.map((g)=><article class="age-card"><span>{g.age}</span><div><h3>{g.focus}</h3><p>{g.desc}</p></div><span class="age-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
  <section class="section section-dark"><div class="container pair"><div><p class="eyebrow">Player-first coaching</p><h2>Good football<br/>starts with good habits.</h2></div><div><p>We want young players to enjoy learning and feel seen as people, not only as footballers. Coaching should challenge players while making space for questions, effort, and progress at each stage.</p><a class="btn btn-outline" href="/about">Learn about the academy ↗</a></div></div></section>
  <style>.page-hero{min-height:590px;position:relative;display:flex;align-items:center;background:var(--navy);color:white}.page-hero>img,.page-overlay{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.page-overlay{background:linear-gradient(90deg,#091a37ed,#091a3780 56%,#091a3720)}.page-title{position:relative;padding:5rem 0}.page-title .eyebrow{color:var(--gold)}.page-title h1{font-size:clamp(3.8rem,9vw,7.4rem)}.page-title>p:not(.eyebrow){color:#e2e9f2;max-width:33rem}.intro-head{max-width:42rem;margin-bottom:2rem}.intro-head>p:last-child{max-width:34rem}.age-grid{border-top:1px solid var(--line)}.age-card{display:grid;grid-template-columns:6rem 1fr auto;gap:1rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid var(--line)}.age-card>span:first-child{font:700 2rem var(--display);color:var(--blue)}.age-card h3{margin:0 0 .4rem}.age-card p{margin:0;max-width:42rem}.age-arrow{font-size:1.4rem;color:var(--blue)}.pair{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}.pair p{color:#c1cddd}.pair h2{font-size:clamp(2.7rem,6vw,5rem)}@media(max-width:700px){.pair{grid-template-columns:1fr;gap:1rem}.age-card{grid-template-columns:4.5rem 1fr auto}.age-card h3{font-size:1.55rem}}
  </style>
</SiteLayout>
