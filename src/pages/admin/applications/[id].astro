---
export const prerender = false;
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { actions } from 'astro:actions';
import { supabaseForRequest } from '../../../lib/supabase-server';
const supabase = supabaseForRequest(Astro.request, Astro.cookies);
if (!supabase) return Astro.redirect('/admin/login');
const { data: { user } } = await supabase.auth.getUser();
if (!user) return Astro.redirect('/admin/login');
const { id } = Astro.params;
const { data: application, error } = await supabase.from('applications').select('*').eq('id',id).maybeSingle();
if (!application && !error) return Astro.redirect('/admin/applications');
const formatDate = (value: string) => new Intl.DateTimeFormat('en-GB',{dateStyle:'full',timeStyle:'short'}).format(new Date(value));
---
<SiteLayout title="Review Application"><section class="section admin-detail"><div class="container"><a class="link-arrow" href="/admin/applications">← All applications</a>{error || !application ? <div class="notice detail-error"><p>This application could not be loaded. Confirm the record exists and your staff access is active.</p></div> : <><div class="detail-heading"><div><p class="eyebrow">Received {formatDate(application.created_at)}</p><h1>{application.player_name}</h1></div><span class={`pill status-${application.status}`}>{application.status}</span></div><div class="detail-grid"><div class="details"><h2>Player & pathway</h2><dl><dt>Pathway</dt><dd>{application.pathway.toUpperCase()}</dd><dt>Academic level</dt><dd>{application.academic_level}</dd><dt>Position</dt><dd>{application.primary_position}</dd></dl><h2>Parent or guardian</h2><dl><dt>Name</dt><dd>{application.guardian_name}</dd><dt>Phone / WhatsApp</dt><dd><a href={`tel:${application.guardian_phone}`}>{application.guardian_phone}</a></dd></dl>{application.message && <><h2>Additional context</h2><p class="message">{application.message}</p></>}</div><aside class="status-panel"><p class="eyebrow">Review status</p><h2>Update this enquiry</h2><p>Choose the current stage for this application.</p><form method="POST" action={actions.updateApplicationStatus}><input type="hidden" name="id" value={application.id}/><label for="status">Application status</label><select id="status" name="status">{['new','reviewing','contacted','closed'].map((item)=><option value={item} selected={application.status===item}>{item}</option>)}</select><button class="btn" type="submit">Save status</button></form><div class="acknowledgements"><strong>Guardian acknowledgements</strong><p>Code of Conduct: {application.conduct_acknowledged ? 'Confirmed' : 'Not confirmed'}</p><p>Medical policy: {application.medical_policy_acknowledged ? 'Confirmed' : 'Not confirmed'}</p></div></aside></div></>}</div></section><style>.admin-detail{min-height:calc(100vh - 14rem)}.detail-heading{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin:2rem 0}.detail-heading h1{font-size:clamp(3rem,7vw,5rem);margin:0}.detail-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:2rem}.details,.status-panel{background:#fff;padding:1.5rem}.details h2,.status-panel h2{font-size:1.8rem;margin:0 0 1rem}.details dl{display:grid;grid-template-columns:10rem 1fr;gap:.7rem;margin-bottom:2rem}.details dt{font-size:.82rem;color:var(--muted)}.details dd{font-weight:600;margin:0}.details dd a{color:var(--blue)}.message{white-space:pre-wrap}.status-panel{border-top:4px solid var(--gold);align-self:start}.status-panel>p:not(.eyebrow){font-size:.85rem}.status-panel form{display:grid;gap:.65rem}.status-panel form label{font-size:.8rem;font-weight:700}.status-panel select{padding:.75rem;border:1px solid var(--line);background:white}.status-panel button{margin-top:.4rem;cursor:pointer}.acknowledgements{border-top:1px solid var(--line);margin-top:1.5rem;padding-top:1rem;font-size:.8rem}.acknowledgements p{margin:.4rem 0}.detail-error{margin-top:2rem}@media(max-width:700px){.detail-grid{grid-template-columns:1fr}.detail-heading{align-items:start;flex-direction:column}.details dl{grid-template-columns:8rem 1fr}}</style></SiteLayout>
